# ==============================================================
# 环境配置模板：复制本文件为 .env 并填入真实值
#   Windows: copy .env.example .env
# ==============================================================

# ---------- LLM配置 ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=2048

# ---------- Embedding / 检索 ----------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4

# ---------- 学习/掌握度 ----------
MASTERY_THRESHOLD=80.0

# ---------- TTS ----------
TTS_VOICE=zh-CN-xiaoyiNeural
TTS_TIMEOUT=10.0

# ---------- 会话 ----------
HISTORY_LIMIT=20

# ---------- 存储/服务 ----------
DATA_DIR=data
HOST=127.0.0.1
PORT=8760
